{
 "about": "Every transcript directory in this study and what it holds. check_runs.py verifies each entry against the files and writes the README index from it. analyze.py reads its BATTERIES from the entries that carry an 'analyze' key.",
 "fields": {
  "id": "stable name for the entry; scripts and pages refer to this, not to the directory",
  "dir": "Contract-A directory, relative to the study; 'layout' says when files sit one level down",
  "battery": "question set: census (31), expanded (65), brands (37 + ext 4 + ext2 3 = 44), brands-lang, or mixed",
  "categories": "categories asked",
  "form": "name, choose, recommend, pick1 (one turn), pick2 (recommend, then 'Which one would you pick?'), or a probe variant",
  "wording": "clamped (one word or name only), free, or both",
  "arm": "served (as the endpoint serves it; models that are not hybrids ran reasoning off where the endpoint accepts it, which for them is the same), off (the hybrids with reasoning off), or temp0",
  "models": "panel, hybrids (the 25 models that accept reasoning off and reason by default), or subset",
  "runs": "runs per scene",
  "spec": "the frozen stimulus every file was run from",
  "tier": "core, extended, check, probe or local (the panel tiers, as current status 2026-10-05)",
  "published": "git tags whose paper reports this directory; never move these",
  "analyze": "the analyze.py battery or batteries this directory feeds; a battery named by several entries reads them all",
  "hybrids": "the models that accept reasoning off and reason by default (top-level list)"
 },
 "hybrids": ["claude-opus-5", "deepseek-v4-flash", "deepseek-v4-pro", "glm-4.7", "gpt-6-luna", "granite-4.2-8b", "grok-4.3", "hunyuan-a13b-instruct", "hy4-preview", "inkling", "inkling-small", "kimi-k2.5", "kimi-k3", "ling-3.0-flash", "mimo-v2.6-pro", "nemotron-3-nano-30b-a3b", "nemotron-3-super-120b-a12b", "nemotron-3-ultra-550b-a55b", "nemotron-3.5-lightning", "qwen3.5-122b-a10b", "qwen3.5-27b", "qwen3.5-9b", "qwen3.6-35b-a3b", "qwen3.7-plus", "qwen3.8-27b"],
